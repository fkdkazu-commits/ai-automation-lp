</div></section>

<!-- 料金（比較表） -->
<section class="sec" id="pricing" style="background:var(--bg2);"><div class="w">
  <div class="sec-label rv">Pricing</div>
  <h2 class="rv">料金プラン</h2>
  <p class="lead rv">2プラン。どちらも<strong>ユーザー数による追加課金はありません</strong>。</p>

  <table class="ptable rv">
    <thead>
      <tr class="reco-row">
        <td></td>
        <td><div class="bub" style="--m:var(--accent2)"><b>全国300地点以上</b>を横断して見たい企業に</div></td>
        <td><div class="bub" style="--m:var(--c-blue)"><b>まず1エリアから</b>小さく始めたい企業に</div></td>
      </tr>
      <tr>
        <th></th>
        <th class="reco plan-h plan-h--g"><span class="pname">人流スコープ</span></th>
        <th class="lite plan-h plan-h--b"><span class="pname">人流スコープ Lite</span></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="rowlab">月額（税込）</td>
        <td class="reco"><span class="pprice">¥480,000<small>/月</small></span></td>
        <td><span class="pprice">¥180,000<small>/月</small></span></td>
      </tr>
      <tr><td class="rowlab">ユーザー数</td><td class="reco">無制限</td><td>10ID</td></tr>
      <tr><td class="rowlab">分析地点（POI）</td><td class="reco">500地点</td><td>200地点</td></tr>
      <tr><td class="rowlab">来訪トラッキング</td><td class="reco">全6機能</td><td>全6機能</td></tr>
      <tr><td class="rowlab">深掘り分析</td><td class="reco">14種類</td><td>4種類</td></tr>
      <tr><td class="rowlab">エリア密集マップ（俯瞰）</td><td class="reco"><span class="yes">対応</span></td><td><span class="no">—</span></td></tr>
      <tr><td class="rowlab">訪日客分析／通行量マップ</td><td class="reco"><span class="yes">オプション</span></td><td><span class="no">—</span></td></tr>
      <tr><td class="rowlab">レポート出力・定期更新</td><td class="reco"><span class="yes">対応</span></td><td><span class="yes-b">対応</span></td></tr>
      <tr class="cta-row">
        <td class="rowlab">契約期間はいずれも1年から</td>
        <td class="reco"><a href="#trial" class="btn btn-gradient" style="width:100%;">無料トライアル</a></td>
        <td><a href="#trial" class="btn btn-outline" style="width:100%;">無料トライアル</a></td>
      </tr>
    </tbody>
