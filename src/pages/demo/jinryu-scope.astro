---
// ─────────────────────────────────────────────────────────────
// デザインサンプル（制作事例）
// 人流データ分析SaaSのLPを想定した架空サービスのページ。
// 社名・サービス名・料金・実績・連絡先はすべて架空。実在の企業・製品とは無関係。
// 検索エンジンに拾わせないため noindex、サイトマップからも除外している。
//
// 画面キャプチャは scripts/mock-*.html を Edge ヘッドレスで撮ったもの。
// ─────────────────────────────────────────────────────────────
import '../../styles/saas-base.css';

const SERVICE = '人流スコープ';
const COMPANY = '株式会社ジオリンクス';
const TITLE = '人流スコープ｜街の人流と実勢商圏を可視化する人流データ分析プラットフォーム【デザインサンプル】';
const DESC = 'デザインサンプルとして制作した架空サービスのLPです。掲載の社名・サービス名・料金・実績はすべて架空のものです。';

const INDUSTRIES = ['流通・小売', '飲食', 'メーカー', '金融・不動産', '建設・インフラ', '官公庁・自治体', '観光・インバウンド'];

const FAQS = [
  ['どのようなデータを使っていますか？', 'スマートフォンアプリから同意を得て取得した位置情報を、個人を特定できない形に統計処理したうえで利用する想定のサンプル記載です。実在のデータ提供元・仕様を示すものではありません。'],
  ['分析地点（POI）はいくつ登録できますか？', '標準プランで500地点、Liteプランで200地点まで。円指定・ポリゴン指定・複数地点の一括登録の3方式に対応する構成です。'],
  ['登録してからどのくらいでデータが見られますか？', '地点登録の翌営業日から、過去分をさかのぼって表示できる想定です。日次データは前日分まで反映されます。'],
  ['スマートフォンやタブレットでも使えますか？', 'PCブラウザでの利用を前提とした設計です。タブレットは閲覧のみ、スマートフォンは主要指標の確認に限定する構成を想定しています。'],
  ['分析結果の読み解きも相談できますか？', 'はい。オンボーディング期間中の伴走に加え、有償のプレミアムサポートではカスタムレポートの作成まで対応する構成にしています。'],
  ['無料トライアルはありますか？', '2週間、契約時と同じ機能をお試しいただける想定です。期間中もサポート窓口をご利用いただけます。'],
  ['契約期間と支払い方法は？', '1年契約・年間一括または月次請求を想定した記載です。実際の条件を示すものではありません。'],
];
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="format-detection" content="telephone=no">
<meta name="theme-color" content="#0b2138">
<meta name="robots" content="noindex,nofollow">
<title>{TITLE}</title>
<meta name="description" content={DESC}>
<meta property="og:type" content="website">
<meta property="og:title" content={TITLE}>
<meta property="og:description" content={DESC}>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="image" href="/demo/mock-map.png" fetchpriority="high">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
/* ═══ このページ固有のスタイル（共通トークンは saas-base.css） ═══ */

.demo-notice{background:var(--ink);color:#fff;font-size:12.5px;line-height:1.7;padding:10px 24px;text-align:center;}
.demo-notice b{color:var(--accent-on-dark);font-weight:800;}
.demo-notice a{text-decoration:underline;text-underline-offset:2px;color:rgba(255,255,255,.72);}
.demo-notice a:hover{color:#fff;}

.demo-notice{background:#061422;}
.nav{position:sticky;top:0;}
.brand-mark{width:30px;height:30px;border-radius:3px;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;}
.brand-text{font-weight:800;font-size:14px;color:var(--ink);white-space:nowrap;}
.brand-text span{display:block;font-size:9.5px;font-weight:700;color:var(--muted2);letter-spacing:.14em;margin-top:1px;}
.nav .btn-dark{background:#efa72c;color:#0b2138;}
.nav .btn-dark:hover{background:#dd9420;}

/* ── ヒーロー直下のアンカーバー（長い縦スクロールの回遊用） ── */
.anchor-bar{background:#071a2c;border-bottom:1px solid rgba(255,255,255,.08);}
.anchor-bar .w{display:flex;justify-content:center;flex-wrap:wrap;}
.anchor-bar a{
  font-size:13px;font-weight:700;color:rgba(255,255,255,.72);
  padding:15px 26px;border-bottom:2px solid transparent;transition:color .18s,border-color .18s;
}
.anchor-bar a:hover{color:#fff;border-bottom-color:var(--c-teal-on-dark);}
@media(max-width:820px){
  .anchor-bar .w{justify-content:flex-start;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;}
  .anchor-bar .w::-webkit-scrollbar{display:none;}
  .anchor-bar a{padding:13px 16px;white-space:nowrap;}
}

/* ── ヒーロー上段：白ベースのオーロラ状グラデーション ──
   ベースに色面を敷き、その上にぼかした色の塊を2つ重ねて奥行きを出す。
   文字が乗る左上だけは白を残して可読性を確保している。 */
.hero{
  overflow:hidden;position:relative;border-bottom:0;padding:80px 0 72px;
  background:
    radial-gradient(52% 62% at 34% 2%, rgba(239,167,44,.30), transparent 66%),
    radial-gradient(58% 72% at 4% 98%, rgba(116,88,200,.26), transparent 62%),
    radial-gradient(72% 88% at 96% 96%, rgba(14,159,110,.24), transparent 60%),
    linear-gradient(158deg,#ffffff 0%,#f4fbfd 38%,#e4f0f6 100%);
}
/* ぼかした色の塊。blur を強めにかけて、面ではなく光に見せる */
.hero::before,.hero::after{content:'';position:absolute;border-radius:50%;pointer-events:none;}
.hero::before{
  width:900px;height:900px;top:-330px;right:-180px;
  background:radial-gradient(closest-side,rgba(15,151,168,.68),rgba(15,151,168,0));
  filter:blur(36px);
}
.hero::after{
  width:760px;height:760px;bottom:-340px;left:-140px;
  background:radial-gradient(closest-side,rgba(47,111,208,.52),rgba(47,111,208,0));
  filter:blur(46px);
}
.hero > .w{position:relative;z-index:1;}
@media(max-width:900px){
  .hero::before{width:560px;height:560px;top:-220px;right:-160px;}
  .hero::after{width:480px;height:480px;bottom:-240px;left:-140px;}
}
.hero-grid{grid-template-columns:1.16fr 1fr;align-items:center;}
.hero-tag{color:var(--c-teal);}
.hero h1{font-size:clamp(27px,3.2vw,41px);color:var(--ink);}
.hero h1 em{color:var(--accent);}
.hero-shot img{width:132%;height:auto;max-width:none;border:1px solid rgba(16,42,67,.1);border-right:0;border-radius:0;box-shadow:-20px 28px 64px -26px rgba(16,42,67,.42);}

/* ── ヒーロー下段：主要指標のダーク帯（大きな色付き数字） ── */
.stats-band{
  position:relative;overflow:hidden;
  background:linear-gradient(120deg,#0b2138 0%,#0d2c40 58%,#07323a 100%);
}
.stats-band::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(closest-side at 76% 18%,rgba(15,151,168,.28),transparent 68%);
}
.stats-band .w{position:relative;z-index:1;}
.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;padding:46px 0;}
.hero-stats b{display:block;font-size:clamp(30px,4.4vw,52px);font-weight:800;letter-spacing:-.035em;line-height:1;color:var(--m);}
.hero-stats b i{font-style:normal;font-size:.44em;font-weight:800;margin-left:4px;letter-spacing:0;}
.hero-stats span{display:block;font-size:12.5px;color:rgba(255,255,255,.5);margin-top:12px;line-height:1.6;}
.hero-stats div:nth-child(1){--m:var(--accent-on-dark);}
.hero-stats div:nth-child(2){--m:var(--c-blue-on-dark);}
.hero-stats div:nth-child(3){--m:var(--c-amber-on-dark);}

/* ページ側のスコープ付き指定は共通CSSより詳細度が高く、
   共通CSS側のメディアクエリだけでは1カラム化されない。ここで明示的に戻す。 */
@media(max-width:900px){
  .hero{padding:44px 0 40px;}
  .hero-grid{grid-template-columns:1fr;}
  .hero-shot img{width:100%;border-right:1px solid rgba(16,42,67,.1);border-radius:0;}
  .hero-stats{gap:24px;padding:32px 0;}
}
@media(max-width:560px){
  .hero-stats{grid-template-columns:1fr;gap:20px;}
  .hero-stats span{margin-top:6px;}
}

/* ── 対応業界：カードをやめて1本の帯にする ── */
.chips-band{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--bg2);padding:22px 0;}
.chips-band .w{display:flex;align-items:center;gap:18px;flex-wrap:wrap;}
.chips-lead{font-size:12px;font-weight:700;color:var(--muted2);letter-spacing:.1em;white-space:nowrap;}
.chips{display:flex;gap:10px 28px;flex-wrap:wrap;}
.chips span{font-size:13.5px;font-weight:700;color:var(--ink);}

/* ── 課題提起：枠なしのステートメント ── */
.stmt{padding:88px 0 76px;}
.stmt h2{font-size:clamp(23px,3vw,35px);font-weight:800;line-height:1.6;letter-spacing:-.015em;max-width:1000px;}
.stmt h2 mark{background:linear-gradient(transparent 62%,rgba(14,159,110,.22) 0);color:inherit;padding:0 2px;}
.stmt-list{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:48px;border-top:1px solid var(--border);}
.stmt-list div{padding:26px 28px 4px 0;border-right:1px solid var(--border);}
.stmt-list div:last-child{border-right:0;padding-right:0;}
.stmt-list h3{font-size:15px;font-weight:800;margin-bottom:8px;}
.stmt-list p{font-size:13px;color:var(--muted);line-height:1.9;}
@media(max-width:820px){.stmt{padding:56px 0 48px;}.stmt-list{grid-template-columns:1fr;}.stmt-list div{border-right:0;border-bottom:1px solid var(--border);padding:22px 0;}.stmt-list div:last-child{border-bottom:0;}}

/* ── 機能：左右交互 ── */
.zig{display:grid;grid-template-columns:1fr 1.3fr;gap:56px;align-items:center;padding:60px 0;border-top:1px solid var(--border);}
.zig--rev .zig-text{order:2;}
.zig-step{font-size:11.5px;font-weight:800;letter-spacing:.16em;color:var(--accent);margin-bottom:12px;}
.zig-text h3{font-size:clamp(21px,2.5vw,27px);font-weight:800;line-height:1.5;letter-spacing:-.015em;margin-bottom:14px;}
.zig-text > p{font-size:14.5px;color:var(--muted);line-height:2;margin-bottom:18px;}
.zig-text .ck li{font-size:13.5px;}
.zig-shot{border-top:3px solid var(--ck-color);padding-top:16px;}
.zig-shot img{width:100%;height:auto;border:1px solid var(--border2);border-radius:0;box-shadow:0 26px 54px -28px rgba(16,42,67,.45);}
.zig-cap{font-size:11.5px;color:var(--muted2);margin-top:10px;}
@media(max-width:900px){.zig{grid-template-columns:1fr;gap:28px;padding:40px 0;}.zig--rev .zig-text{order:0;}}

/* ── インバウンド（ダーク・非対称）
   ヒーローとサポートが紺なので、ここだけ深いティールにして帯を作り分ける ── */
#inbound{background:#07323a;}
.inb{display:grid;grid-template-columns:.85fr 1fr;gap:56px;align-items:center;}
.inb-big{font-size:clamp(56px,8vw,104px);font-weight:800;line-height:1;letter-spacing:-.04em;color:var(--accent-on-dark);}
.inb-big small{display:block;font-size:14px;font-weight:700;letter-spacing:.06em;color:rgba(255,255,255,.5);margin-top:12px;}
.inb-sub{display:flex;gap:32px;margin-top:32px;flex-wrap:wrap;}
.inb-sub div b{display:block;font-size:22px;font-weight:800;color:#fff;letter-spacing:-.02em;}
.inb-sub div span{font-size:12px;color:rgba(255,255,255,.5);}
@media(max-width:900px){.inb{grid-template-columns:1fr;gap:28px;}}

/* ── 料金：比較表 ── */
.ptable{width:100%;border-collapse:collapse;margin-top:36px;background:#fff;border-top:2px solid var(--ink);}
.ptable th,.ptable td{padding:15px 20px;border-bottom:1px solid var(--border);text-align:left;font-size:13.5px;vertical-align:middle;}
.ptable thead th{background:var(--bg2);font-size:12px;letter-spacing:.04em;color:var(--muted);font-weight:700;}
.ptable thead th:not(:first-child){text-align:center;}
.ptable td:not(:first-child){text-align:center;}
.ptable tr:last-child td{border-bottom:0;}
.ptable .pname{font-size:17px;font-weight:800;color:var(--ink);}
.ptable .pprice{font-size:26px;font-weight:800;letter-spacing:-.02em;line-height:1.2;}
.ptable .pprice small{font-size:11.5px;font-weight:700;color:var(--muted);margin-left:3px;}
.ptable .reco{background:var(--accent-soft);}
.ptable .reco .pname{color:var(--accent2);}
.ptable .yes{color:var(--accent);font-weight:800;}
.ptable .no{color:var(--muted2);}
.ptable .rowlab{font-weight:700;color:var(--ink);width:38%;}
.ptable .cta-row td{padding-top:18px;padding-bottom:20px;}
@media(max-width:760px){.ptable{display:block;overflow-x:auto;white-space:nowrap;}.ptable .rowlab{width:auto;}}

/* ── 事例：1件大きく、2件小さく ── */
.case-feat{display:grid;grid-template-columns:1.15fr 1fr;gap:48px;align-items:center;margin-top:36px;padding:36px 0;border-top:3px solid var(--c-coral);border-bottom:1px solid var(--border);}
.case-feat .quote{font-size:clamp(19px,2.3vw,25px);font-weight:800;line-height:1.7;letter-spacing:-.01em;}
.case-feat .meta{font-size:12.5px;color:var(--muted);margin-top:18px;}
.case-feat .num{font-size:clamp(54px,7vw,92px);font-weight:800;color:var(--c-coral);letter-spacing:-.04em;line-height:1;}
.case-feat .numlab{font-size:12.5px;color:var(--muted);margin-top:8px;line-height:1.7;}
.case-sub{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px;padding-top:32px;border-top:1px solid var(--border);}
.case-sub h4{font-size:15.5px;font-weight:800;margin-bottom:9px;}
.case-sub p{font-size:13px;color:var(--muted);line-height:1.95;}
.case-sub .m{font-size:13px;font-weight:800;color:var(--accent);margin-top:12px;}
@media(max-width:820px){.case-feat{grid-template-columns:1fr;gap:24px;padding:26px;}.case-sub{grid-template-columns:1fr;gap:26px;}}

/* ── サポート：番号付きリスト ── */
.sup-list{display:grid;grid-template-columns:1fr 1fr;gap:0 48px;margin-top:32px;}
.sup-list li{display:flex;gap:16px;padding:18px 0;border-bottom:1px solid rgba(255,255,255,.1);list-style:none;}
.sup-list b{font-size:12px;font-weight:800;color:var(--accent-on-dark);letter-spacing:.1em;padding-top:3px;flex-shrink:0;}
.sup-list h4{font-size:14.5px;font-weight:800;color:#fff;margin-bottom:3px;}
.sup-list p{font-size:12.5px;color:rgba(255,255,255,.55);line-height:1.75;}
@media(max-width:760px){.sup-list{grid-template-columns:1fr;}}

/* ── トライアル帯 ── */
.trial{background:var(--accent-soft);border-top:1px solid rgba(14,159,110,.16);border-bottom:1px solid rgba(14,159,110,.16);padding:64px 0;}
.trial .w{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;}
.trial h2{font-size:clamp(23px,3vw,32px);font-weight:800;line-height:1.55;letter-spacing:-.015em;}
.trial p{font-size:14px;color:var(--muted);line-height:2;margin-top:14px;}
.trial-pts{display:flex;flex-direction:column;gap:12px;}
.trial-pts div{border-left:3px solid var(--m);padding:2px 0 2px 16px;font-size:14px;font-weight:800;}
.trial-pts div span{display:block;font-size:12px;font-weight:400;color:var(--muted);margin-top:3px;}
@media(max-width:820px){.trial .w{grid-template-columns:1fr;gap:28px;}.trial{padding:44px 0;}}

/* ═══ カテゴリ配色の割り当て ═══
   「分析の段階」「業種」「サポートの層」など種類の違いに色を当てる。
   CTA（緑）とは役割を分けているので、緑ボタンの目立ちは落ちない。 */

/* 業種チップ：頭のドットで色分け */
.chips span{display:inline-flex;align-items:center;gap:8px;}
.chips span::before{content:'';width:7px;height:7px;border-radius:2px;background:var(--m);}
.chips span:nth-child(1){--m:var(--c-blue);}
.chips span:nth-child(2){--m:var(--c-coral);}
.chips span:nth-child(3){--m:var(--c-amber);}
.chips span:nth-child(4){--m:var(--accent);}
.chips span:nth-child(5){--m:var(--c-purple);}
.chips span:nth-child(6){--m:var(--c-teal);}
.chips span:nth-child(7){--m:var(--c-coral);}

/* 課題提起：3つの論点を色で分ける */
.stmt-list h3{display:flex;align-items:center;gap:10px;}
.stmt-list h3::before{content:'';width:10px;height:10px;border-radius:3px;background:var(--m);flex-shrink:0;}
.stmt-list div:nth-child(1){--m:var(--c-coral);}
.stmt-list div:nth-child(2){--m:var(--c-amber);}
.stmt-list div:nth-child(3){--m:var(--c-purple);}

/* 機能：4つの段階に固有の色を与える（ラベル・チェック・見出しの下線） */
.zig-step{color:var(--ck-color);}
.zig-text h3{border-left:3px solid var(--ck-color);padding-left:14px;margin-left:-17px;}
.zig--s1{--ck-color:var(--c-blue);}
.zig--s2{--ck-color:var(--accent);}
.zig--s3{--ck-color:var(--c-purple);}
.zig--s4{--ck-color:var(--c-amber);}
@media(max-width:900px){.zig-text h3{margin-left:0;}}

/* インバウンド：ダーク背景側もモノトーンにしない */
.inb-big{color:var(--c-teal-on-dark);}
.inb-sub div:nth-child(1) b{color:var(--accent-on-dark);}
.inb-sub div:nth-child(2) b{color:var(--c-blue-on-dark);}
.inb-sub div:nth-child(3) b{color:var(--c-amber-on-dark);}

/* 料金：Liteプランは青系に振って、緑の標準プランと役割を分ける */
.ptable .lite .pname{color:var(--c-blue);}
.ptable .yes-b{color:var(--c-blue);font-weight:800;}
.ptable .btn-outline{border-color:var(--c-blue);color:var(--c-blue);}
.ptable .btn-outline:hover{background:var(--c-blue-soft);}

/* 事例：指標ごとに色を変える */
.case-sub div:nth-child(1) .m{color:var(--c-blue);}
.case-sub div:nth-child(2) .m{color:var(--c-purple);}

/* サポート：5段階を5色で */
.sup-list li:nth-child(1) b{color:var(--accent-on-dark);}
.sup-list li:nth-child(2) b{color:var(--c-blue-on-dark);}
.sup-list li:nth-child(3) b{color:var(--c-purple-on-dark);}
.sup-list li:nth-child(4) b{color:var(--c-amber-on-dark);}
.sup-list li:nth-child(5) b{color:var(--c-teal-on-dark);}

/* 導入の流れ：5ステップも色分けする（先頭2つは line / progress 要素） */
.flow-step-v2:nth-child(3){--m:var(--c-blue);}
.flow-step-v2:nth-child(4){--m:var(--c-purple);}
.flow-step-v2:nth-child(5){--m:var(--c-amber);}
.flow-step-v2:nth-child(6){--m:var(--c-teal);}
.flow-step-v2:nth-child(7){--m:var(--accent);}
.flow-step-v2 .fs-num{color:var(--m);}
.flow-step-v2 .fs-icon{border-color:var(--m);color:var(--m);}
.flow-step-v2:hover .fs-icon{background:var(--m);color:#fff;}
.flow-progress{background:linear-gradient(90deg,var(--c-blue),var(--c-purple),var(--c-amber),var(--c-teal),var(--accent));opacity:.35;}

/* ── 導入の流れ：円形バッジをやめ、色付きの罫線と大きな番号で組む ── */
.flow-timeline{display:grid;grid-template-columns:repeat(5,1fr);gap:28px;margin-top:40px;padding:0;}
.flow-line,.flow-progress{display:none;}
.flow-step-v2{text-align:left;border-top:3px solid var(--m);padding-top:16px;}
.flow-step-v2 .fs-num{font-size:32px;font-weight:800;letter-spacing:-.04em;line-height:1;margin-bottom:10px;color:var(--m);}
.flow-step-v2 .fs-icon{width:auto;height:auto;margin:0 0 8px;border:0;background:none;border-radius:0;justify-content:flex-start;color:var(--m);}
.flow-step-v2 .fs-icon svg{width:20px;height:20px;}
.flow-step-v2:hover .fs-icon{background:none;color:var(--m);}
.flow-step-v2 .fs-title{font-size:15px;}
@media(max-width:820px){.flow-timeline{grid-template-columns:1fr 1fr;gap:22px;}}
@media(max-width:520px){.flow-timeline{grid-template-columns:1fr;}}

/* 料金表：おすすめ列は角丸の箱ではなく、上に色の帯を敷いて示す */
.ptable thead th.reco{box-shadow:inset 0 4px 0 var(--accent);}
.ptable thead th.lite{box-shadow:inset 0 4px 0 var(--c-blue);}

/* トライアルの3点：枠をやめて色の縦罫だけにする */
.trial-pts div:nth-child(1){--m:var(--accent);}
.trial-pts div:nth-child(2){--m:var(--c-blue);}
.trial-pts div:nth-child(3){--m:var(--c-amber);}

/* セクションラベルも1色に固定しない */
#pricing .sec-label{color:var(--c-blue);}

/* ── 用途別ダッシュボード：画面をデバイス枠に入れて並べる ── */
.tpl-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:40px;}
.tpl-frame{background:#0b2138;padding:7px 7px 12px;border-radius:5px;box-shadow:0 18px 38px -20px rgba(11,33,56,.5);}
.tpl-frame img{width:100%;height:auto;border-radius:2px;display:block;}
.tpl figcaption{margin-top:16px;}
.tpl figcaption b{display:block;font-size:15.5px;font-weight:800;color:var(--m);letter-spacing:-.005em;}
.tpl figcaption span{display:block;font-size:12.5px;color:var(--muted);margin-top:5px;line-height:1.7;}
.tpl:nth-child(1){--m:var(--c-amber);}
.tpl:nth-child(2){--m:var(--c-purple);}
.tpl:nth-child(3){--m:var(--accent);}
.tpl:nth-child(4){--m:var(--c-blue);}
@media(max-width:900px){.tpl-grid{grid-template-columns:1fr 1fr;gap:22px;}}
@media(max-width:560px){.tpl-grid{grid-template-columns:1fr;}}

/* ── 料金表：推奨コメントの吹き出し＋色ベタのプラン名 ── */
.ptable .reco-row td{border-bottom:0;padding:0 14px 16px;text-align:center;}
.bub{position:relative;border:1.5px solid var(--m);color:var(--m);padding:9px 14px;font-size:12.5px;font-weight:700;line-height:1.65;border-radius:3px;background:#fff;}
.bub b{font-weight:800;font-size:14px;}
.bub::before,.bub::after{content:'';position:absolute;left:50%;transform:translateX(-50%);border-style:solid;border-color:transparent;}
.bub::before{bottom:-9px;border-width:9px 8px 0;border-top-color:var(--m);}
.bub::after{bottom:-7px;border-width:7px 6px 0;border-top-color:#fff;}
.ptable thead th.plan-h{background:var(--m);color:#fff;border-bottom:0;}
.ptable thead th.plan-h .pname{color:#fff;font-size:16.5px;}
.ptable thead th.plan-h--g{--m:var(--accent);}
.ptable thead th.plan-h--b{--m:var(--c-blue);}
.ptable .reco{background:#f6fafc;}
@media(max-width:760px){.bub{font-size:11.5px;}.bub b{font-size:12.5px;}}

/* ═══ 背景の作り分け ═══
   白ベタと薄緑ベタが続くと平坦なので、白いセクションは寒色寄りの微グラデにし、
   帯は緑一色ではなく紺・ティール側に振る。 */

/* 白いセクションに、ごく薄い階調をつける */
.chips-band{background:linear-gradient(180deg,#f7fafc 0%,#eef4f8 100%);}
.stmt{background:linear-gradient(180deg,#ffffff 0%,#f8fbfd 100%);}
#functions{background:linear-gradient(180deg,#fafcfe 0%,#ffffff 55%);}
#pricing{background:linear-gradient(180deg,#eef4f8 0%,#f8fbfd 100%);}
#cases{background:linear-gradient(180deg,#ffffff 0%,#f7fafc 100%);}
#faq{background:linear-gradient(180deg,#f9fbfd 0%,#ffffff 60%);}

/* トライアル帯：薄緑ベタをやめ、寒色の階調＋左の色罫だけで見せる */
.trial{
  background:linear-gradient(135deg,#eef4f8 0%,#f6fafc 45%,#eaf3f6 100%);
  border-top:1px solid #dbe6ee;border-bottom:1px solid #dbe6ee;
  position:relative;
}
.trial::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(closest-side at 82% 30%,rgba(15,151,168,.12),transparent 70%);
}
.trial .w{position:relative;z-index:1;}

/* 最終CTA：薄緑の面ではなく、紺→ティールのダーク帯で締める */
.cta-sec{
  background:linear-gradient(120deg,#0b2138 0%,#0d2c40 55%,#07323a 100%);
  border-top:0;color:#fff;position:relative;overflow:hidden;
}
.cta-sec::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(closest-side at 72% 20%,rgba(15,151,168,.3),transparent 68%),
             radial-gradient(closest-side at 18% 90%,rgba(47,111,208,.22),transparent 70%);
}
.cta-sec > .w{position:relative;z-index:1;}
.cta-sec h2{color:#fff;}
.cta-sec h2 em{color:var(--c-teal-on-dark);}
.cta-sec .lead{color:rgba(255,255,255,.68);}
.cta-sec .btn-outline{background:transparent;color:#fff;border-color:rgba(255,255,255,.32);}
.cta-sec .btn-outline:hover{border-color:var(--c-teal-on-dark);color:var(--c-teal-on-dark);}
.cta-sec > .w > div:last-child{color:rgba(255,255,255,.45)!important;}

/* ── フッター注記 ── */
.foot-note{background:var(--bg2);border-top:1px solid var(--border);padding:26px 0;}
.foot-note p{font-size:12px;color:var(--muted);line-height:1.95;text-align:center;max-width:780px;margin:0 auto;}
</style>
</head>
