---
// pro-lp-builder テンプレート由来の共通デザインシステム（カラートークン・タイポ・
// ボタン・カード・レスポンシブ）。ページ固有の指定は下部の <style> に書くこと
// （スコープ付きスタイルは属性セレクタ分だけ詳細度が高く、必ずこちらに勝つ）。
import '../styles/lp-base.css';

// ─────────────────────────────────────────────────────────────
// 公開URLはここ1か所だけ変更すれば canonical / OGP / JSON-LD に反映されます。
// 独自ドメイン確定後は astro.config.mjs の site と vercel.json の Link ヘッダも合わせてください。
// ─────────────────────────────────────────────────────────────
const SITE_URL = 'https://ai-automation-lp.vercel.app';
const X_URL = 'https://x.com/Marketer_kazuf';
const X_HANDLE = '@Marketer_kazuf';
const MAIL = 'fkdkazu@gmail.com';
// 問い合わせ導線（既存GitHub Pages側のフォームページ）
const CONTACT_URL = 'https://fkdkazu-commits.github.io/ai-consulting-lp/contact.html';

const TITLE = 'AI業務自動化支援｜福田和弘 — Claude Code × AWS で、御社の生産性を変える';
const DESC = 'ITマネジメント20年以上の経験を持つAI業務自動化の専門家。Claude Codeで自動化ツールを設計・実装し、AWSで社内展開まで一貫サポート。10,000円〜。';

const FAQS = [
  ['開発の知識がなくても依頼できますか？', 'はい、問題ありません。業務の課題や「こんなことを自動化したい」というご要望をお聞きするところから始めます。技術的な知識は一切不要です。'],
  ['どんな業種でも対応できますか？', 'はい、業種は問いません。採用・HR、マーケティング、問い合わせ対応、レポート作成など、繰り返し発生する業務であれば幅広く対応可能です。'],
  ['納期はどのくらいですか？', 'ご支援メニューによって異なります。スポット開発支援は内容確定後おおよそ1週間〜、業務委託支援は契約開始後すぐに着手、DXスターターパックは要件確定から数か月規模が目安です。内容によって変動しますので、まずはご相談ください。'],
  ['導入後のサポートはありますか？', 'あります。スポット開発でも操作マニュアルをお渡しします。継続的な改善・運用相談が必要な場合は、月額の業務委託支援（AIエンジニア＋AI顧問）でそのまま伴走します。'],
  ['外部APIの費用はどのくらいかかりますか？', 'Claude API（Anthropic）やその他APIの利用料は別途実費となります。利用量によりますが、一般的な業務利用では月数百〜数千円程度が目安です。事前にご説明します。'],
  ['Claude Codeなどでツールを作ったあと、どうやって社内展開すればよいですか？', '自分のPC上で動くツールをチーム全体で使えるようにするには、AWSへの移行・構築が有効です。処理規模や用途に応じて最適な構成をご提案しますので、まずは現状のツール内容をお聞かせください。セキュリティ設定・運用コストの見直しも含めてサポートします。'],
  ['まず相談だけでも大丈夫ですか？', 'もちろんです。「自動化できるかどうかわからない」という段階でも歓迎です。XのDMかメールでお気軽にご連絡ください。'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: '福田 和弘',
      alternateName: 'Kazuhiro Fukuda',
      url: `${SITE_URL}/`,
      image: `${SITE_URL}/images/profile.png`,
      jobTitle: 'AI業務自動化コンサルタント / AI顧問',
      email: MAIL,
      knowsAbout: ['Claude Code', 'AWS', '業務自動化', 'DX推進', 'SEO', 'Power Automate', 'Copilot Studio'],
      sameAs: [X_URL],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#service`,
      name: 'AI業務自動化支援（福田和弘）',
      url: `${SITE_URL}/`,
      image: `${SITE_URL}/ogp.png`,
      description: DESC,
      areaServed: 'JP',
      priceRange: '¥10,000〜',
      founder: { '@id': `${SITE_URL}/#person` },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'ご支援サービス',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Claude Code スポット開発支援' }, priceCurrency: 'JPY', price: '10000' },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Claude Code 業務委託支援' }, priceCurrency: 'JPY', price: '50000' },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '中小企業向け DXスターターパック' }, priceCurrency: 'JPY', price: '650000' },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Claude Code 個別家庭教師' }, priceCurrency: 'JPY', price: '3000' },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'AI業務自動化支援｜福田和弘',
      inLanguage: 'ja',
      publisher: { '@id': `${SITE_URL}/#person` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQS.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="format-detection" content="telephone=no">
<meta name="theme-color" content="#1a1714">
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1">
<meta name="author" content="福田 和弘">
<meta name="keywords" content="AI業務自動化,Claude Code,Claude Code 開発代行,AI顧問,業務効率化,DX推進,中小企業 DX,AWS,SEO自動化,福田和弘">
<link rel="canonical" href={`${SITE_URL}/`}>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<title>{TITLE}</title>
<meta name="description" content={DESC}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="AI業務自動化支援｜福田和弘">
<meta property="og:locale" content="ja_JP">
<meta property="og:url" content={`${SITE_URL}/`}>
<meta property="og:title" content={TITLE}>
<meta property="og:description" content={DESC}>
