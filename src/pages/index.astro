// スクロールリビール
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('v'); });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.rv').forEach(el => obs.observe(el));
// スクリーンショット用の静的モード
if (location.search.includes('static')) document.querySelectorAll('.rv').forEach(el => el.classList.add('v'));

// ナビの背景をスクロールで濃くする
const nav = document.querySelector('.nav');
window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 20);
}, { passive: true });

// 活用事例カルーセルの進捗バー（モバイルのみ表示）
(function () {
  const grid = document.querySelector('#usecases .usecase-grid');
  const bar = document.getElementById('usecase-progress-bar');
  if (!grid || !bar) return;
  function updateBar() {
    const max = grid.scrollWidth - grid.clientWidth;
    const pct = max > 0 ? grid.scrollLeft / max : 0;
    bar.style.transform = 'translateX(' + (pct * 75) + '%)';
  }
  grid.addEventListener('scroll', updateBar, { passive: true });
  updateBar();
})();

// お知らせ：「すべて見る」で7件目以降を開閉
(function () {
  const btn = document.getElementById('newsMore');
  if (!btn) return;
  const label = btn.querySelector('.news-more-label');
  btn.addEventListener('click', () => {
    const isOpen = btn.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(isOpen));
    label.textContent = isOpen ? '閉じる' : 'すべて見る';
    document.querySelectorAll('#newsGrid .news-card').forEach((card, i) => {
      if (i >= 6) card.classList.toggle('is-hidden', !isOpen);
    });
  });
})();
</script>
</body>
</html>
