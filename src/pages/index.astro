<meta name="twitter:creator" content={X_HANDLE}>
<meta name="twitter:title" content={TITLE}>
<meta name="twitter:description" content={DESC}>
<meta name="twitter:image" content={`${SITE_URL}/ogp.png`}>
<meta name="twitter:image:alt" content="AI業務自動化支援 福田和弘 — Claude Code × AWS">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="image" href="/images/marketing-dashboard-sample.png" type="image/png" fetchpriority="high">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
<style>
/* ═══ このLP固有の追加スタイル（テンプレ共通トークンを利用） ═══ */

/* Brand mark（ロゴ画像を持たないためテキスト＋モノグラムで構成） */
.brand-mark{width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#d4622a,#e8844e);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:14px;letter-spacing:-.02em;flex-shrink:0;box-shadow:0 4px 12px rgba(212,98,42,.28);}
.brand-text{font-weight:800;font-size:13px;letter-spacing:.02em;color:var(--ink);white-space:nowrap;}
.brand-text b{font-weight:900;}

/* Ticker（導入実績アプリ名の2段マーキー） */
.ticker-wrap.ticker-2row{padding:0;}
.ticker-row{display:flex;overflow:hidden;padding:11px 0;white-space:nowrap;}
.ticker-row + .ticker-row{border-top:1px solid var(--border);}
.ticker-row .ticker{animation-duration:42s;}
.ticker-row.rev .ticker{animation-direction:reverse;animation-duration:52s;}
.ticker span{display:inline-flex;align-items:center;gap:8px;}
.ticker span::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0;}

/* Stats 4カラム */
.stats.stats-4{grid-template-columns:repeat(4,1fr);}
@media(max-width:900px){.stats.stats-4{grid-template-columns:repeat(2,1fr);}}

/* Problem */
.pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:40px;}
.pain-card{background:#fff;border:1px solid var(--border);border-radius:16px;padding:24px 26px;display:flex;gap:16px;align-items:flex-start;box-shadow:var(--shadow-sm);transition:all .3s cubic-bezier(.16,1,.3,1);}
.pain-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);border-color:rgba(212,98,42,.3);}
.pain-icon{font-size:26px;line-height:1;flex-shrink:0;margin-top:2px;}
.pain-t{font-size:15px;font-weight:800;color:var(--ink);line-height:1.6;}
.pain-t span{display:block;font-size:12.5px;font-weight:400;color:var(--muted);margin-top:6px;line-height:1.75;}
.pain-resolve{margin-top:36px;background:var(--accent-soft);border:1px solid rgba(212,98,42,.18);border-radius:var(--radius-lg);padding:28px 36px;text-align:center;}
.pain-resolve p{font-size:clamp(16px,2.2vw,20px);font-weight:900;color:var(--ink);line-height:1.7;}
.pain-resolve em{font-style:normal;color:var(--accent);}
@media(max-width:900px){.pain-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:600px){.pain-grid{grid-template-columns:1fr;gap:12px;}.pain-card{padding:18px 20px;}.pain-resolve{padding:22px 20px;}}

/* Features（選ばれる3つの理由） */
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:40px;}
.feat-card{position:relative;overflow:hidden;border:1px solid var(--border);border-radius:18px;padding:34px 30px;background:#fff;transition:all .3s cubic-bezier(.16,1,.3,1);}
.feat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--accent),var(--accent-light));}
.feat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);}
.feat-n{font-size:40px;font-weight:900;color:var(--accent-soft);line-height:1;margin-bottom:6px;letter-spacing:-.03em;}
.feat-card h3{font-size:19px;font-weight:900;line-height:1.45;margin-bottom:12px;letter-spacing:-.01em;}
.feat-card p{font-size:13.5px;color:var(--muted);line-height:1.95;}
@media(max-width:900px){.feat-grid{grid-template-columns:1fr;}}

/* Services（価格バッジ＋チェックリスト） */
.svc-price{font-size:12.5px;font-weight:800;padding:6px 14px;border-radius:100px;background:var(--accent-soft);color:var(--accent);white-space:nowrap;}
.svc-card--dark .svc-price{background:rgba(232,132,78,.16);color:#e8a472;}
.svc-card .ck{margin:18px 0 22px;}
.svc-card--dark .ck li{color:rgba(255,255,255,.72);}
.svc-card--dark .ck li::before{color:#e8844e;}
.svc-foot{margin-top:34px;background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px 28px;font-size:14px;color:var(--muted);line-height:1.95;text-align:center;}
.svc-foot a{color:var(--accent);font-weight:800;border-bottom:1.5px solid rgba(212,98,42,.3);}

/* Showcase（導入実績・事例） */
.sc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px;}
.sc-card{display:block;background:#fff;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);transition:all .3s cubic-bezier(.16,1,.3,1);text-decoration:none;color:inherit;}
.sc-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--border2);}
.sc-thumb{aspect-ratio:16/9;overflow:hidden;background:var(--bg2);}
.sc-thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s ease;}
.sc-card:hover .sc-thumb img{transform:scale(1.04);}
.sc-thumb--ph{display:flex;flex-direction:column;justify-content:center;padding:22px 24px;color:#fff;position:relative;}
.sc-thumb--ph::after{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.16) 1px,transparent 1px);background-size:14px 14px;opacity:.5;}
.sc-thumb--ph span{position:relative;z-index:1;font-size:clamp(16px,2.2vw,20px);font-weight:900;line-height:1.45;letter-spacing:-.01em;text-shadow:0 2px 12px rgba(0,0,0,.25);}
.ph-warm{background:linear-gradient(135deg,#1a1714 0%,#7a3a1c 55%,#d4622a 100%);}
.ph-teal{background:linear-gradient(135deg,#134e4a 0%,#0f766e 55%,#14b8a6 100%);}
.sc-body{padding:18px 20px 20px;}
.sc-cat{display:inline-block;font-size:11px;font-weight:700;color:var(--accent);background:var(--accent-soft);padding:3px 11px;border-radius:100px;margin-bottom:10px;}
.sc-title{font-size:14.5px;font-weight:800;line-height:1.55;margin-bottom:8px;color:var(--ink);}
.sc-desc{font-size:12.5px;color:var(--muted);line-height:1.8;margin-bottom:12px;}
.sc-metric{font-size:13px;font-weight:800;color:var(--accent);display:flex;align-items:center;gap:6px;}
.sc-metric::before{content:'';width:14px;height:2px;background:var(--accent);display:inline-block;flex-shrink:0;}
.sc-more{text-align:center;margin-top:40px;}
@media(max-width:880px){.sc-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:560px){.sc-grid{grid-template-columns:1fr;}}

/* News */
.news-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:34px;}
.news-more{display:inline-flex;align-items:center;gap:14px;background:none;border:0;padding:0;cursor:pointer;font-family:inherit;font-size:13px;font-weight:800;color:var(--ink);}
.news-more-circle{width:44px;height:44px;border-radius:50%;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;transition:background .25s,transform .25s;}
.news-more:hover .news-more-circle{background:var(--accent);}
.news-more.is-open .news-more-circle{transform:rotate(-90deg);}
.news-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:32px 24px;}
.news-card{display:block;text-decoration:none;color:inherit;}
.news-card.is-hidden{display:none;}
.news-thumb-img{width:100%;height:auto;aspect-ratio:720/514;object-fit:cover;border-radius:10px;display:block;background:var(--bg2);transition:opacity .2s;}
.news-card:hover .news-thumb-img{opacity:.92;}
.news-thumb{position:relative;aspect-ratio:720/514;border-radius:10px;overflow:hidden;display:flex;flex-direction:column;justify-content:center;padding:20px 24px;color:#fff;}
.news-thumb::after{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.16) 1px,transparent 1px);background-size:14px 14px;opacity:.55;}
.news-thumb-tag{position:relative;z-index:1;align-self:flex-start;font-size:11px;font-weight:700;letter-spacing:.06em;padding:4px 12px;border-radius:20px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);margin-bottom:12px;}
.news-thumb-text{position:relative;z-index:1;font-size:clamp(17px,2.2vw,21px);font-weight:900;line-height:1.45;letter-spacing:-.01em;text-shadow:0 2px 12px rgba(0,0,0,.25);}
.news-thumb--case{background:linear-gradient(135deg,#1a1714 0%,#7a3a1c 55%,#d4622a 100%);}
.news-thumb--new{background:linear-gradient(135deg,#7c2d12 0%,#b45309 55%,#dd6b20 100%);}
.news-card-date{display:block;font-size:12.5px;color:var(--muted2);font-weight:700;margin:16px 0 6px;letter-spacing:.02em;}
.news-card-title{font-size:15px;font-weight:700;line-height:1.7;color:var(--ink);transition:color .2s;}
.news-card:hover .news-card-title{color:var(--accent);}
@media(max-width:600px){.news-grid{grid-template-columns:1fr;gap:26px;}}

/* Profile（ダークバンド） */
.prof-band{background:linear-gradient(180deg,var(--deep) 0%,var(--deep2) 100%);color:#fff;padding:88px 0;}
.prof-grid{display:grid;grid-template-columns:280px 1fr;gap:56px;align-items:center;}
.prof-avatar{width:260px;height:260px;border-radius:50%;overflow:hidden;border:4px solid rgba(255,255,255,.12);box-shadow:0 30px 70px rgba(0,0,0,.45);margin:0 auto;}
.prof-avatar img{width:100%;height:100%;object-fit:cover;object-position:center 30%;}
.prof-name{font-size:30px;font-weight:900;letter-spacing:-.02em;}
.prof-role{font-size:13px;color:var(--claude);font-weight:700;margin-top:8px;letter-spacing:.02em;}
.prof-bio{font-size:14.5px;color:rgba(255,255,255,.72);line-height:2;margin-top:20px;}
.prof-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px;}
.prof-tags span{font-size:11.5px;font-weight:700;color:#f3b483;background:rgba(232,132,78,.12);border:1px solid rgba(232,132,78,.25);padding:5px 13px;border-radius:100px;}
.prof-link{display:inline-flex;align-items:center;gap:6px;margin-top:26px;font-size:13.5px;font-weight:800;color:#fff;border-bottom:2px solid rgba(232,132,78,.5);padding-bottom:3px;transition:all .2s;}
.prof-link:hover{color:var(--claude);border-color:var(--claude);}
@media(max-width:900px){.prof-grid{grid-template-columns:1fr;gap:32px;text-align:center;}.prof-tags{justify-content:center;}.prof-avatar{width:200px;height:200px;}.prof-band{padding:56px 0;}}

/* CTA 内のセカンダリボタン（ダーク） */
.btn-x{background:#000;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.25);}
.btn-x:hover{background:#222;transform:translateY(-1px);}
</style>

<script defer src="/_vercel/insights/script.js"></script>
<script defer src="/_vercel/speed-insights/script.js"></script>
</head>
<body>

<!-- NAV -->
<nav class="nav"><div class="w">
  <a href="#top" class="nav-brand">
    <span class="brand-mark">F</span>
    <span class="brand-text">福田和弘 <b>| AI業務自動化</b></span>
  </a>
  <div class="nav-links">
    <a href="#services">サービス</a>
    <a href="#usecases">活用事例</a>
    <a href="#results">導入実績</a>
    <a href="#profile">プロフィール</a>
    <a href="#faq">FAQ</a>
  </div>
  <a href={CONTACT_URL} class="btn btn-dark">無料相談・お問合せ &rarr;</a>
</div></nav>

<!-- HERO -->
<section class="hero" id="top"><div class="w">
  <div class="hero-grid">
    <div>
      <div class="hero-tag">AI業務自動化支援 &mdash; Claude Code &times; 業務設計</div>
      <h1>業務の無駄を削ぎ落とし、<br><em>AIが働く仕組み</em>をつくる。</h1>
      <p class="hero-sub"><strong>ITマネジメント20年以上</strong>の経験をもとに、貴社の業務課題を整理し、Claude Codeで自動化ツールを設計・実装。<strong>AWSをはじめ、さまざまな環境で使える状態</strong>まで、一貫して対応します。</p>
      <div class="hero-actions">
        <a href={X_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gradient" style="font-size:15.5px;padding:15px 32px;">𝕏 まずは気軽に相談する</a>
        <a href={CONTACT_URL} class="btn btn-outline" style="font-size:15.5px;padding:15px 32px;">✉ まずは無料相談</a>
      </div>
      <div class="hero-trust">
        <div class="hero-trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>SEO記事制作コスト 約80%削減</div>
        <div class="hero-trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>ITマネジメント20年以上</div>
        <div class="hero-trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>自社・支援先への導入 20本以上</div>
      </div>
